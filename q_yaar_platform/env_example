IS_LOCAL=True
IS_PREPROD=False
IS_PROD=False

DEBUG=True

DATABASE_URL=DATABASE_URL
REDIS_URL=REDIS_URL

TEST_DB_NAME=TEST_DB_NAME

POSTGRES_DB=DB_NAME
POSTGRES_USER=DB_USER
POSTGRES_PASSWORD=DB_PASSWORD

# Object storage (S3-compatible, e.g. Deuxfleurs/Garage)
S3_ENDPOINT_URL=https://garage.example.invalid
S3_REGION=garage
S3_ACCESS_KEY_ID=GK...
S3_SECRET_ACCESS_KEY=...
S3_BUCKET_NAME=q-yaar
S3_SECURE=True
S3_PRESIGN_GET_EXPIRY=604800
S3_PRESIGN_PUT_EXPIRY=900

SKIP_NOTIFICATIONS=True
SKIP_S3=True

VAPID_PUBLIC_KEY=VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=VAPID_PRIVATE_KEY
VAPID_ADMIN_EMAIL=VAPID_ADMIN_EMAIL

ENV=dev # | staging | prod
PORT=8000 # (dev, staging) | 8001 (prod)
DB_PORT=5436 (dev) # | 5432 (staging); unused in prod (no db container)
COMPOSE_PROFILES=db # (dev, staging); unset in prod
CORE_COMMAND=bash -c "python manage.py migrate && gunicorn q_yaar.wsgi:application --bind 0.0.0.0:8000 --workers 5"
